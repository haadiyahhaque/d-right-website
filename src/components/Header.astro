---
interface Props {
  active?: string;
  demoHref?: string;
  demoLabel?: string;
  demoModal?: boolean;
}

const {
  active = "home",
  demoHref = "/solutions/mgw#demo",
  demoLabel = "Book a demo",
  demoModal = false,
} = Astro.props;
const isHome = active === "home";
const isMgw = active === "mgw";
const isLaris = active === "laris";
const isCareers = active === "careers";
const isContact = active === "contact";
const isBlog = active === "blog";
const solutionsOpen = active === "mgw" || active === "laris" || active === "intelligist";
const resourcesOpen = isBlog || active === "faq";
---

<header class="site-header" data-header>
  <div class="header-inner">
    <a
      class="brand"
      href="/"
      aria-label="D-Right Technologies — home"
      aria-current={isHome ? "page" : undefined}
    >
      <img
        class="brand-logo"
        src="/assets/d-right-logo.png"
        alt="D-Right Technologies"
        width="168"
        height="48"
      />
    </a>
    <nav class="nav" aria-label="Primary">
      <a href="/" class:list={[{ "is-active": isHome }]} aria-current={isHome ? "page" : undefined}>Home</a>
      <a href="/about">About</a>
      <div class="nav-item" data-nav-item>
        <button
          type="button"
          class:list={["nav-trigger", { "is-active": solutionsOpen }]}
          aria-expanded="false"
          aria-haspopup="true"
          data-menu-trigger
        >
          Solutions
        </button>
        <div class="nav-menu nav-menu-wide" data-menu hidden>
          <a href="/solutions/mgw" class:list={[{ "is-active": isMgw }]} aria-current={isMgw ? "page" : undefined}>
            <strong>MGW</strong><span>Medical Grade Website</span>
          </a>
          <a href="/solutions/laris" class:list={[{ "is-active": isLaris }]} aria-current={isLaris ? "page" : undefined}>
            <strong>LARIS</strong><span>Lab ERP</span>
          </a>
          <a href="/solutions/intelligist"><strong>IntelliSist</strong><span>AI clinical assistant</span></a>
        </div>
      </div>
      <div class="nav-item" data-nav-item>
        <button
          type="button"
          class:list={["nav-trigger", { "is-active": resourcesOpen }]}
          aria-expanded="false"
          aria-haspopup="true"
          data-menu-trigger
        >
          Resources
        </button>
        <div class="nav-menu" data-menu hidden>
          <a href="/resources/blog" class:list={[{ "is-active": isBlog }]} aria-current={isBlog ? "page" : undefined}>
            <strong>Blog</strong><span>Articles &amp; updates</span>
          </a>
          <a href="/resources/faq"><strong>FAQ</strong><span>Common questions</span></a>
        </div>
      </div>
      <a href="/careers" class:list={[{ "is-active": isCareers }]} aria-current={isCareers ? "page" : undefined}>Careers</a>
      <a href="/contact" class:list={[{ "is-active": isContact }]} aria-current={isContact ? "page" : undefined}>Contact</a>
    </nav>
    <div class="header-actions">
      <a class="phone" href="tel:+923033330023" aria-label="Call +92 303 333 0023" title="+92 303 333 0023">
        <svg class="phone-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
          <path
            fill="currentColor"
            d="M6.6 10.8c1.4 2.8 3.8 5.1 6.6 6.6l2.2-2.2c.3-.3.7-.4 1.1-.2 1.2.4 2.5.6 3.8.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1C10.6 21 3 13.4 3 4c0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.3.2 2.6.6 3.8.1.4 0 .8-.3 1.1L6.6 10.8z"
          ></path>
        </svg>
        <span>Call</span>
      </a>
      {demoModal ? (
        <button type="button" class="btn btn-sm" data-demo-open>{demoLabel}</button>
      ) : (
        <a class="btn btn-sm" href={demoHref}>{demoLabel}</a>
      )}
      <button class="nav-toggle" type="button" aria-label="Open menu" aria-expanded="false" data-nav-toggle>
        <span></span><span></span>
      </button>
    </div>
  </div>
</header>

<div class="mobile-nav" data-mobile-nav hidden>
  <a href="/" class:list={[{ "is-active": isHome }]} aria-current={isHome ? "page" : undefined}>Home</a>
  <a href="/about">About</a>
  <p class="mobile-label">Solutions</p>
  <a href="/solutions/mgw" class:list={[{ "is-active": isMgw }]} aria-current={isMgw ? "page" : undefined}>MGW</a>
  <a href="/solutions/laris" class:list={[{ "is-active": isLaris }]} aria-current={isLaris ? "page" : undefined}>LARIS</a>
  <a href="/solutions/intelligist">IntelliSist</a>
  <p class="mobile-label">Resources</p>
  <a href="/resources/blog" class:list={[{ "is-active": isBlog }]} aria-current={isBlog ? "page" : undefined}>Blog</a>
  <a href="/resources/faq">FAQ</a>
  <a href="/careers" class:list={[{ "is-active": isCareers }]} aria-current={isCareers ? "page" : undefined}>Careers</a>
  <a href="/contact" class:list={[{ "is-active": isContact }]} aria-current={isContact ? "page" : undefined}>Contact</a>
  {demoModal ? (
    <button type="button" class="btn" data-demo-open>{demoLabel}</button>
  ) : (
    <a class="btn" href={demoHref}>{demoLabel}</a>
  )}
</div>
