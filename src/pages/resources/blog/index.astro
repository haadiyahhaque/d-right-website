---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { posts, formatPostDate } from "../../../data/posts";

const sorted = [...posts].sort((a, b) => b.date.localeCompare(a.date));
---

<BaseLayout
  title="Blog — D-Right Technologies"
  description="Articles and updates from D-Right on medical-grade websites, lab software and clinical AI for practices in Pakistan."
  bodyClass="page-blog"
  active="blog"
  demoHref="/solutions/mgw#demo"
  demoLabel="Book a demo"
  footerVariant="home"
>
  <main id="main">
    <section class="section blog-hero" aria-labelledby="blog-title">
      <div class="blog-hero-inner" data-reveal>
        <p class="eyebrow">Resources</p>
        <h1 id="blog-title">Blog</h1>
        <p class="blog-lead">
          Notes on practice websites, laboratory workflows and clinical technology — written for
          doctors, clinics, hospitals and labs.
        </p>
      </div>
    </section>

    <section class="section blog-list-section" aria-labelledby="posts-title">
      <h2 id="posts-title" class="visually-hidden">Articles</h2>
      <div class="blog-grid" data-reveal>
        {
          sorted.map((post, i) => (
            <article class="blog-card" style={`--i:${i}`}>
              <p class="blog-card-meta">
                <span>{post.category}</span>
                <span aria-hidden="true">·</span>
                <time datetime={post.date}>{formatPostDate(post.date)}</time>
                <span aria-hidden="true">·</span>
                <span>{post.readMins} min read</span>
              </p>
              <h3>
                <a href={`/resources/blog/${post.slug}`}>{post.title}</a>
              </h3>
              <p>{post.excerpt}</p>
              <a class="product-link" href={`/resources/blog/${post.slug}`}>Read article →</a>
            </article>
          ))
        }
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
</style>
